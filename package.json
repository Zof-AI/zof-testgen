{
  "name": "@zof-ai/testgen",
  "version": "0.1.1",
  "description": "Reviewable regression test candidates with deterministic and opt-in local Ollama generation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "zof-testgen": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "examples",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zof-AI/zof-testgen.git"
  },
  "homepage": "https://github.com/Zof-AI/zof-testgen#readme",
  "bugs": {
    "url": "https://github.com/Zof-AI/zof-testgen/issues"
  },
  "keywords": [
    "verification",
    "testing",
    "zof"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "test:package": "node tests/package.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.11"
  },
  "dependencies": {
    "typescript": "5.9.3",
    "@zof-ai/evidence-spec": "0.1.1"
  }
}
